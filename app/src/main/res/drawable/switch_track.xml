<?xml version="1.0" encoding="utf-8"?>
<!-- The whole visible switch: the track and the thumb. Flipping the switch plays the matching
     transition; when the screen opens, the switch shows its state without one. -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:id="@+id/switch_on"
        android:drawable="@drawable/switch_on"
        android:state_checked="true" />
    <item
        android:id="@+id/switch_off"
        android:drawable="@drawable/switch_off" />
    <transition
        android:drawable="@drawable/switch_turn_on"
        android:fromId="@id/switch_off"
        android:toId="@id/switch_on" />
    <transition
        android:drawable="@drawable/switch_turn_off"
        android:fromId="@id/switch_on"
        android:toId="@id/switch_off" />
</animated-selector>
