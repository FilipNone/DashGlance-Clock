<?xml version="1.0" encoding="utf-8"?>
<!-- A clock dial with the Android Auto mark on it; the triangle's tip points at 12.
     Path data is in values/icon_paths.xml. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="@color/brand_ink"
        android:pathData="@string/icon_dial" />

    <path
        android:pathData="@string/icon_major_ticks"
        android:strokeWidth="2.6"
        android:strokeColor="@color/brand_paper"
        android:strokeLineCap="round" />

    <path
        android:pathData="@string/icon_minor_ticks"
        android:strokeWidth="1.8"
        android:strokeColor="@color/brand_paper"
        android:strokeLineCap="round" />

    <path
        android:fillColor="@color/brand_orange"
        android:pathData="@string/icon_triangle"
        android:strokeWidth="4.6"
        android:strokeColor="@color/brand_orange"
        android:strokeLineJoin="round" />

    <path
        android:fillColor="@color/brand_paper"
        android:pathData="@string/icon_arrow"
        android:strokeWidth="2.3"
        android:strokeColor="@color/brand_paper"
        android:strokeLineJoin="round" />
</vector>
