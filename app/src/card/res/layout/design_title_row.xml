<?xml version="1.0" encoding="utf-8"?>
<!-- The design list's title, with the stacked switch on its right. MainActivity shows the
     switch only for digital designs. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="40dp"
    android:orientation="horizontal"
    android:paddingStart="18dp"
    android:paddingEnd="12dp">

    <TextView
        android:id="@+id/design_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingVertical="4dp"
        android:textSize="16sp" />

    <Switch
        android:id="@+id/stacked"
        style="@style/Widget.DashGlance.PillSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:saveEnabled="false"
        android:switchPadding="12dp"
        android:text="@string/stacked_toggle"
        android:textSize="14sp"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

</LinearLayout>
