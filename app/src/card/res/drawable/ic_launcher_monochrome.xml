<?xml version="1.0" encoding="utf-8"?>
<!-- Themed icon layer. The launcher tints it with one color and keeps only the alpha, so the
     dial is left out. The gap between the two notes keeps them apart. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:pathData="@string/icon_major_ticks"
        android:strokeWidth="2.6"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />

    <path
        android:pathData="@string/icon_minor_ticks"
        android:strokeWidth="1.8"
        android:strokeColor="#FF000000"
        android:strokeLineCap="round" />

    <path
        android:fillColor="#FF000000"
        android:pathData="@string/icon_note_back" />

    <path
        android:fillColor="#FF000000"
        android:pathData="@string/icon_note_front" />
</vector>
